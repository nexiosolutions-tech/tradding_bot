# Copie este arquivo para backend/.env e preencha com suas chaves da testnet
# (https://testnet.binance.vision). Nunca commite o .env — já está no .gitignore.

# Gere em testnet.binance.vision (login via GitHub -> "Generate HMAC_SHA256 Key").
# O secret só é mostrado uma vez no momento da geração — copie os dois já.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trava de segurança: só "true" é aceito sem intervenção manual no código
# (bootstrap.py recusa BINANCE_TESTNET=false — ver CLAUDE.md regra 1/6).
BINANCE_TESTNET=true

# Par observado pelo Orchestrator.
SYMBOL=BTCUSDT

# Capital inicial "de papel" usado pelo RiskManager para dimensionar posições
# (não é uma transferência real — a testnet já dá saldo fake de conta).
INITIAL_EQUITY=1000

# Descomente e ajuste só se for usar Postgres em vez do SQLite local
# (results/tradingbot.db) — ex. a connection string do addon do Railway.
# DATABASE_URL=postgresql://user:senha@host:5432/tradingbot

# Descomente só se o dashboard estiver rodando em outro host/porta que não
# localhost:5173/127.0.0.1:5173 (os defaults já cobrem isso).
# DASHBOARD_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Opcional: protege os comandos de controle do engine (pause/resume/acknowledge) e o
# WebSocket /ws/engine com uma chave. Sem isso configurado, esses endpoints ficam abertos
# (comportamento anterior) — defina antes de expor o dashboard publicamente. Deve bater
# com VITE_DASHBOARD_API_KEY no frontend.
# DASHBOARD_API_KEY=
